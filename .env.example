# ─────────────────────────────────────────────
# Telegram Reminder Bot — Environment Variables
# ─────────────────────────────────────────────

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Google Gemini API key from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Default timezone for all chats (tz database name, e.g. America/New_York)
# Users can override this per-chat with the /timezone command.
DEFAULT_TIMEZONE=America/Argentina/Cordoba
